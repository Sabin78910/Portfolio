---
import { Font } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sabin Khanal" />
    <meta name="robots" content="max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sabin Khanal" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#070b16" />
    <meta name="color-scheme" content="dark" />
    <!-- Google Search favicons must be PNG/ICO etc. (not SVG), square, ideally a multiple of 48px.
         Every icon link is the portrait so Google can't pick a different one. -->
    <link rel="icon" href="/favicon.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <Font cssVariable="--font-sans" preload />
    <!-- Lets CSS hide reveal-on-scroll content only when JS can reveal it again, and paint the cookie banner with the page
         (not after scripts, which made it the late LCP element) only until a choice is stored; mirrors readConsent() -->
    <script is:inline>document.documentElement.classList.add('js'); try { if (/^(granted|denied)$/.test(localStorage.getItem('consent'))) document.documentElement.classList.add('consent-chosen'); } catch {}</script>
    <!-- Trusted Types: Vercel Analytics sets script.src from a plain string, at a per-project path (/<id>/script.js).
         Allow only same-origin script.js URLs; HTML and inline-script sinks stay blocked (no createHTML/createScript). -->
    <script is:inline>window.trustedTypes?.createPolicy('default', { createScriptURL: (u) => (new URL(u, location.href).origin === location.origin && u.endsWith('/script.js') ? u : null) });</script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- Visible until the visitor chooses (see the head script); equal-weight buttons, so declining is as easy as accepting -->
    <section class="consent card" data-consent aria-label="Cookie consent">
      <p>May I use Google Analytics cookies to see how visitors find this site? Nothing from Google loads unless you accept.</p>
      <div class="consent__actions">
        <button class="btn btn--sm" type="button" data-choice="denied">Decline</button>
        <button class="btn btn--sm" type="button" data-choice="granted">Accept</button>
      </div>
    </section>
    <script>
      import '../scripts/consent.ts';
    </script>
    <!-- In <body>, not <head>: an unknown element in <head> makes the parser close it early -->
    <Analytics />
  </body>
</html>
