---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Sabin Khanal" description="This page doesn't exist.">
  <main class="wrap" style="min-height:100svh;display:grid;place-content:center;justify-items:center;gap:1.25rem;text-align:center">
    <p class="eyebrow"><span class="mono">404</span> Not found</p>
    <h1 style="font-size:clamp(2.2rem,6vw,4rem);letter-spacing:-0.04em;line-height:1.05;font-weight:600">
      This route doesn’t <span class="grad">resolve.</span>
    </h1>
    <p class="muted">The page you’re looking for has moved or never existed.</p>
    <a class="btn btn--primary" href="/">Back to home</a>
  </main>
</Base>
