---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import Icon from '../components/Icon.astro';
import photo from '../assets/sabin-portrait.webp';
import { profile, nav, about, experience, projects, projectsIntro, education, stats, githubBand } from '../data/profile';
import { ridgeHeight } from '../lib/ridge.ts';

const year = new Date().getFullYear();
const [currentJob] = experience;
const [degree] = education;
// One card per role, newest first (resume layout).
const roles = experience.flatMap((job) => job.roles.map((r) => ({ ...r, company: job.company, place: job.place })));
// Static range from the same height function as the particles: the LCP-safe poster and the low-motion fallback.
const ridgeLayers = [
  { z: 1, base: 440, scale: 210, cls: 'far' },
  { z: 0.62, base: 490, scale: 160, cls: 'mid' },
  { z: 0.28, base: 545, scale: 110, cls: 'near' },
].map(({ z, base, scale, cls }) => {
  const pts = Array.from({ length: 81 }, (_, i) => `${(i * 12.5).toFixed(1)},${(base - ridgeHeight((i / 80) * 2 - 1, z) * scale).toFixed(1)}`);
  return { cls, d: `M0,600 L${pts.join(' L')} L1000,600 Z` };
});
const iconLinks = [
  { label: 'GitHub', icon: 'github', href: profile.github, external: true },
  { label: 'LinkedIn', icon: 'linkedin', href: profile.linkedin, external: true },
  { label: 'Email', icon: 'mail', href: `mailto:${profile.email}`, external: false },
];

// Google: WebSite (site name in results) + ProfilePage centred on one Person (about-me pages are eligible).
const site = Astro.site!.href;
const person = {
  '@type': 'Person',
  name: profile.name,
  description: profile.description,
  jobTitle: profile.role,
  url: site,
  image: new URL('/og.png', Astro.site).href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Kathmandu', addressCountry: 'NP' },
  worksFor: { '@type': 'Organization', name: currentJob.company },
  alumniOf: { '@type': 'CollegeOrUniversity', name: degree.school.replace(' (UK)', '') },
  sameAs: [profile.github, profile.linkedin],
};
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: profile.name, url: site },
    { '@type': 'ProfilePage', url: site, mainEntity: person },
  ],
};

const commands = [
  ...nav.map((n) => ({ label: `Go to ${n.label}`, hint: 'Section', href: n.href })),
  { label: 'Copy email address', hint: profile.email, action: 'copy' },
  { label: 'Download CV', hint: 'PDF', href: profile.cv, download: true },
  { label: 'Open GitHub', hint: 'github.com/Sabin78910', href: profile.github, external: true },
  { label: 'Open LinkedIn', hint: 'linkedin.com', href: profile.linkedin, external: true },
  { label: 'Pause motion', hint: 'Accessibility', action: 'motion' },
];
---

<Base title={`${profile.name} — ${profile.role}`} description={profile.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <a class="skip" href="#main">Skip to content</a>

  <header class="nav">
    <div class="nav__bar">
      <a class="nav__brand" href="#top" aria-label={`${profile.name}, back to top`}>{profile.name}</a>
      <nav aria-label="Primary">
        <ul class="nav__links">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="nav__actions">
        <button class="kbd-btn" type="button" data-cmdk-open aria-label="Menu ⌘K" aria-keyshortcuts="Meta+K Control+K">
          <kbd>⌘</kbd><kbd>K</kbd><span class="kbd-btn__touch">Menu</span>
        </button>
        <a class="btn btn--ghost btn--sm hide-xs" href={profile.cv} download>CV</a>
        <a class="btn btn--primary btn--sm" href="#contact">Let’s talk</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ── Hero ─────────────────────────────────────────── -->
    <section id="top" class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__grid" aria-hidden="true"></div>
      <canvas class="hero__canvas" data-ridge aria-hidden="true"></canvas>
      <svg class="hero__poster" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
        {ridgeLayers.map((l) => <path class={`ridge--${l.cls}`} d={l.d} />)}
      </svg>
      <div class="wrap hero__inner">
        <div class="hero__copy">
          <p class="eyebrow hero__hello">Hello, I’m</p>
          <h1 class="hero__title"><span class="line"><span class="grad">{profile.name}</span></span></h1>
          <p class="hero__role">{profile.tagline}</p>
          <p class="hero__loc"><Icon name="pin" />{profile.location}</p>
          <div class="hero__cta">
            <a class="btn btn--primary" href="#projects">View my work <span aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href="#contact">Get in touch</a>
            <a class="btn btn--ghost" href={profile.cv} download>Download CV <Icon name="download" /></a>
          </div>
          <ul class="icon-links hero__links">
            {iconLinks.map((l) => (
              <li><a class="icon-btn" href={l.href} aria-label={l.label} target={l.external ? '_blank' : undefined} rel={l.external ? 'me noopener' : undefined}><Icon name={l.icon} /></a></li>
            ))}
          </ul>
        </div>

        <div class="hero__visual">
          <figure class="profile" data-tilt>
            <div class="profile__photo">
              <Image src={photo} alt="Portrait of Sabin Khanal" widths={[340, 500]} sizes="(max-width: 860px) 90vw, 330px" priority />
            </div>
          </figure>
        </div>
      </div>
      <div class="wrap">
        <ul class="stats card card--accent" role="list" aria-label="Key metrics">
          {stats.map((s) => (
            <li class="stat">
              <span class="stat__value grad">{s.value}</span>
              <span class="stat__label">{s.label}</span>
            </li>
          ))}
        </ul>
      </div>
      <button class="btn btn--ghost btn--sm hero__motion" type="button" data-motion-toggle hidden>Pause motion</button>
    </section>

    <!-- ── About ────────────────────────────────────────── -->
    <section id="about" class="section">
      <div class="wrap">
        <header class="section__head" data-reveal>
          <h2>About <span class="grad">me</span></h2>
          <span class="section__ghost" aria-hidden="true">About</span>
        </header>
        <div class="about">
          <div class="about__story" data-reveal>
            {about.paragraphs.map((p, i) => <p class={i === 0 ? 'about__lead' : 'muted'}>{p}</p>)}
            <ul class="about__notes">
              {about.notes.map((n) => <li><strong>{n.label}:</strong> {n.text}</li>)}
            </ul>
            <p><a class="btn btn--primary" href={profile.linkedin} target="_blank" rel="me noopener">Find me on LinkedIn <span aria-hidden="true">↗</span></a></p>
          </div>
          <div class="facts card" data-reveal>
            <h3 class="facts__title">Profile summary</h3>
            <dl>
              {about.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Experience ───────────────────────────────────── -->
    <section id="experience" class="section section--alt">
      <div class="wrap">
        <header class="section__head" data-reveal>
          <h2>Where I’ve <span class="grad">worked.</span></h2>
          <span class="section__ghost" aria-hidden="true">Experience</span>
          <p class="section__sub muted">{profile.summary}</p>
          <a class="btn btn--primary section__cta" href={profile.cv} download>Download CV <Icon name="download" /></a>
        </header>
        <ol class="entries">
          {roles.map((r) => (
            <li class="entry card" data-reveal>
              <p class="entry__period mono">{r.period}</p>
              <h3>{r.title}</h3>
              <p class="entry__org">{r.company} · {r.place}</p>
              <ul class="ticks">
                {r.points.map((p) => <li>{p}</li>)}
              </ul>
              <ul class="tags">{r.tags.map((t) => <li>{t}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── Education ────────────────────────────────────── -->
    <section id="education" class="section">
      <div class="wrap">
        <header class="section__head" data-reveal>
          <h2>Where I’ve <span class="grad">studied.</span></h2>
          <span class="section__ghost" aria-hidden="true">Education</span>
        </header>
        <ol class="entries">
          {education.map((e) => (
            <li class="entry card" data-reveal>
              <p class="entry__period mono">{e.period}</p>
              <h3>{e.title}</h3>
              <p class="entry__org">{e.school}</p>
              {e.note && <p class="muted">{e.note}</p>}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── Projects ─────────────────────────────────────── -->
    <section id="projects" class="section section--alt">
      <div class="wrap">
        <header class="section__head" data-reveal>
          <h2>Projects, <span class="grad">built end to end.</span></h2>
          <span class="section__ghost" aria-hidden="true">Projects</span>
          <p class="section__sub muted">{projectsIntro}</p>
        </header>
        <div class="projects">
          {projects.map((p, i) => (
            <article class={`project card glow--${p.color}`} data-reveal>
              <figure class="project__visual" data-tilt>
                <ProjectVisual kind={p.visual} />
              </figure>
              <div class="project__body">
                <p class="eyebrow"><span class="num">{String(i + 1).padStart(2, '0')}</span>{p.kind}</p>
                <h3>{p.title}</h3>
                <p class="project__summary">{p.summary}</p>
                <ul class="ticks">
                  {p.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── More on GitHub: full-width band over the Himalaya outline ── -->
    <aside class="gh" aria-labelledby="gh-title">
      <svg class="gh__ridge" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        {ridgeLayers.map((l) => <path class={`ridge--${l.cls}`} d={l.d} />)}
      </svg>
      <div class="wrap gh__inner" data-reveal>
        <header class="section__head">
          <h2 id="gh-title">More projects on <span class="grad">GitHub</span></h2>
          <span class="section__ghost" aria-hidden="true">GitHub</span>
        </header>
        <p class="gh__tagline">{githubBand.tagline}</p>
        <p class="muted gh__sub">{githubBand.cta}</p>
        <a class="btn btn--primary gh__btn" href={profile.github} target="_blank" rel="me noopener"><Icon name="github" /> Visit GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </aside>

    <!-- ── Contact ──────────────────────────────────────── -->
    <section id="contact" class="section contact">
      <div class="contact__glow" aria-hidden="true"></div>
      <div class="wrap">
        <div class="contact__card card card--accent" data-reveal>

          <!-- Left: info panel -->
          <div class="contact__info">
            <header class="section__head contact__head">
              <p class="eyebrow">Let’s build something</p>
              <h2>Get in <span class="grad">touch.</span></h2>
            </header>
            <p class="contact__desc muted">Have a project or role in mind? Let’s talk. Write a message here, or reach me directly.</p>
            <div class="contact__actions">
              <a class="btn btn--primary" href={`mailto:${profile.email}`}>Email</a>
              <button class="btn" type="button" data-copy={profile.email}>
                <span data-copy-status aria-live="polite">Copy email</span>
              </button>
              <a class="btn" href={profile.github} target="_blank" rel="me noopener">GitHub</a>
            </div>
          </div>

          <!-- Right: form -->
          <form class="form" action="/api/contact" method="post" data-contact novalidate>
            <div class="field">
              <label for="f-name">Your name</label>
              <input id="f-name" name="name" autocomplete="name" required minlength="2" maxlength="100" />
            </div>
            <div class="field">
              <label for="f-email">Your email</label>
              <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="254" />
            </div>
            <div class="field">
              <label for="f-subject">What’s it about?</label>
              <select id="f-subject" name="subject">
                <option value="role">A role or interview</option>
                <option value="project">A project or collaboration</option>
                <option value="question">A question</option>
                <option value="other">Something else</option>
              </select>
            </div>
            <div class="field">
              <label for="f-message">Message</label>
              <textarea id="f-message" name="message" rows="5" required minlength="10" maxlength="5000"></textarea>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="f-company">Company</label>
              <input id="f-company" name="company" tabindex="-1" autocomplete="off" />
            </div>
            <button class="btn btn--primary form__send" type="submit">
              <span data-submit-label>Send by email</span>
            </button>
            <p class="form__status" role="status" aria-live="polite" data-form-status></p>
          </form>

        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <p class="footer__copy">© {year} {profile.name}</p>
    </div>
  </footer>

  <!-- ── Command palette ───────────────────────────────── -->
  <dialog class="cmdk" data-cmdk aria-label="Command menu">
    <div class="cmdk__box">
      <input class="cmdk__input" type="text" placeholder="Type a command or search…" aria-label="Search commands" data-cmdk-input autocomplete="off" />
      <ul class="cmdk__list" role="listbox" data-cmdk-list>
        {commands.map((c) => (
          <li role="option" aria-selected="false">
            <a
              href={c.href ?? '#'}
              data-action={c.action}
              download={c.download ? '' : undefined}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener' : undefined}
            >
              <span>{c.label}</span><span class="cmdk__hint">{c.hint}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="cmdk__foot mono">↑↓ navigate · ↵ select · esc close</p>
    </div>
  </dialog>

  <script>
    import '../scripts/main.ts';
  </script>
</Base>
