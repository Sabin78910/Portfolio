---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import SkillsShowcase from '../components/SkillsShowcase.astro';
import photo from '../assets/sabin-portrait.webp';
import { profile, nav, stack, bfcWork, experience, projects, education, principles } from '../data/profile';

const year = new Date().getFullYear();
const [currentJob] = experience;
const [currentRole] = currentJob.roles;
const since = currentRole.period.split(' — ')[0];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: Astro.site?.href,
  image: new URL('/og.png', Astro.site).href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Kathmandu', addressCountry: 'NP' },
  worksFor: { '@type': 'Organization', name: currentJob.company },
  alumniOf: { '@type': 'CollegeOrUniversity', name: education.school },
  sameAs: [profile.github, profile.linkedin],
};

const commands = [
  ...nav.map((n) => ({ label: `Go to ${n.label}`, hint: 'Section', href: n.href })),
  { label: 'Copy email address', hint: profile.email, action: 'copy' },
  { label: 'Download CV', hint: 'PDF', href: profile.cv, download: true },
  { label: 'Open GitHub', hint: 'github.com/Sabin78910', href: profile.github, external: true },
  { label: 'Open LinkedIn', hint: 'linkedin.com', href: profile.linkedin, external: true },
  { label: 'Pause motion', hint: 'Accessibility', action: 'motion' },
];
---

<Base title={`${profile.name} — ${profile.role}`} description={profile.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personLd)} />

  <a class="skip" href="#main">Skip to content</a>

  <header class="nav">
    <div class="nav__bar">
      <a class="nav__brand" href="#top" aria-label={`${profile.name}, back to top`}>{profile.name}</a>
      <nav aria-label="Primary">
        <ul class="nav__links">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="nav__actions">
        <button class="kbd-btn" type="button" data-cmdk-open aria-label="Open menu (Ctrl or Command + K)">
          <kbd>⌘</kbd><kbd>K</kbd><span class="kbd-btn__touch">Menu</span>
        </button>
        <a class="btn btn--ghost btn--sm hide-xs" href={profile.cv} download>Résumé</a>
        <a class="btn btn--primary btn--sm" href="#contact">Let’s talk</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ── Hero ─────────────────────────────────────────── -->
    <section id="top" class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="wrap hero__inner">
        <div class="hero__copy">
          <p class="badge"><span class="status__dot"></span>Currently at Best Finance Company</p>
          <h1 class="hero__title">
            <span class="line"><span>I engineer secure,</span></span>{' '}
            <span class="line"><span>reliable <span class="grad">backend</span></span></span>{' '}
            <span class="line"><span><span class="grad">systems.</span></span></span>
          </h1>
          <p class="hero__lead">
            {profile.role} in Kathmandu. Python, Flask and PostgreSQL, tested before anything ships.
          </p>
          <div class="hero__cta">
            <a class="btn btn--primary" href="#work">View projects <span aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href={profile.cv} download>Download résumé</a>
          </div>
          <p class="hero__micro">Open to backend &amp; full-stack roles · Kathmandu, UTC+5:45</p>
        </div>

        <div class="hero__visual">
          <canvas class="hyper" data-hypercube aria-hidden="true"></canvas>
          <figure class="profile" data-tilt>
            <div class="profile__photo">
              <Image src={photo} alt="Portrait of Sabin Khanal" widths={[340, 500]} sizes="(max-width: 860px) 90vw, 330px" priority />
            </div>
            <figcaption class="profile__meta">
              <div>
                <strong>{profile.name}</strong>
                <span>{profile.role}</span>
              </div>
              <div class="profile__time">
                <span class="mono" data-clock>--:--</span>
                <span>Kathmandu</span>
              </div>
            </figcaption>
            <p class="chip chip--a"><span class="status__dot"></span>Developer at BFC</p>
            <p class="chip chip--b">{education.degree}</p>
          </figure>
          <div class="dims" role="group" aria-label="Hypercube dimension">
            <span class="dims__label">Live <b data-dim-label>4</b>D hypercube · drag to spin</span>
            <span class="dims__btns">
              {[4, 6, 8].map((d) => (
                <button type="button" data-dim={d} aria-pressed={d === 4 ? 'true' : 'false'}>{d}D</button>
              ))}
            </span>
          </div>
        </div>
      </div>

    </section>

    <div class="marquee" aria-label="Technologies I work with">
      <ul class="marquee__track">
        {stack.map((s) => <li>{s}</li>)}
        {stack.map((s) => <li aria-hidden="true">{s}</li>)}
      </ul>
    </div>

    <!-- ── Projects ─────────────────────────────────────── -->
    <section id="work" class="section">
      <div class="wrap">
        <header class="section__head" data-reveal>
          <p class="eyebrow">Projects</p>
          <h2>Built end to end, <span class="grad">from schema to screen.</span></h2>
        </header>
        <div class="projects">
          {projects.map((p, i) => (
            <article class={`project card glow--${p.color}`} data-reveal>
              <div class="project__visual" data-tilt>
                <ProjectVisual kind={p.visual} />
              </div>
              <div class="project__body">
                <p class="eyebrow"><span class="num">{String(i + 1).padStart(2, '0')}</span>{p.kind}</p>
                <h3>{p.title}</h3>
                <p class="project__summary">{p.summary}</p>
                <ul class="ticks">
                  {p.points.map((pt) => <li>{pt}</li>)}
                </ul>
                <ul class="chips" aria-label="Tech stack">
                  {p.stack.map((s) => <li>{s}</li>)}
                </ul>
                {'repo' in p && (
                  <p><a class="link" href={p.repo} target="_blank" rel="noopener">View code <span aria-hidden="true">↗</span><span class="visually-hidden"> for {p.title}</span></a></p>
                )}
              </div>
            </article>
          ))}
        </div>
        <p class="more" data-reveal>
          <a class="link" href={profile.github} target="_blank" rel="me noopener">More on GitHub <span aria-hidden="true">↗</span></a>
        </p>
      </div>
    </section>

    <!-- ── About (bento) ────────────────────────────────── -->
    <section id="about" class="section section--alt">
      <div class="wrap">
        <header class="section__head" data-reveal>
          <p class="eyebrow">About</p>
          <h2>Quiet, <span class="grad">correct</span> systems.</h2>
        </header>
        <div class="bento">
          <article class="tile tile--story card card--accent" data-reveal>
            <p class="tile__big">Transaction processing engines should be <span class="grad">relentlessly predictable</span> in the best way—unwaveringly secure, impeccably accurate, and continuously online.</p>
            <p class="muted">
              At Best Finance Company Ltd. I work across the transaction and IT teams. I build internal platforms, help
              keep the Digital Lending System fast, secure and compliant, and test my own work before it reaches
              production. A background in QA means I write code thinking about how it could break.
            </p>
          </article>

          <article class="tile tile--now card" data-reveal>
            <p class="eyebrow">Now</p>
            <h3>{currentRole.title}</h3>
            <p class="muted">{currentJob.company} · since {since}</p>
            <p class="badge badge--sm"><span class="status__dot"></span>Shipping to production</p>
          </article>

          <article class="tile tile--clock card" data-reveal>
            <p class="eyebrow">Local time</p>
            <p class="tile__clock mono" data-clock data-seconds>--:--:--</p>
            <p class="muted">Kathmandu · UTC+5:45</p>
          </article>

          <article class="tile tile--edu card" data-reveal>
            <p class="eyebrow">Education</p>
            <h3>{education.degree}</h3>
            <p class="muted">{education.school} · {education.year}</p>
          </article>

          <article class="tile tile--shipped card" data-reveal>
            <p class="eyebrow">Systems at Best Finance Company</p>
            <ul class="shipped">
              {bfcWork.map((s) => (
                <li><strong>{s.name}</strong><span class="mono">{s.note}</span></li>
              ))}
            </ul>
          </article>

          <article class="tile tile--principles card" data-reveal>
            <p class="eyebrow">How I work</p>
            <ol class="principles">
              {principles.map((pr, i) => <li><span class="num">{String(i + 1).padStart(2, '0')}</span>{pr}</li>)}
            </ol>
          </article>
        </div>
      </div>
    </section>

    <!-- ── Experience ───────────────────────────────────── -->
    <section id="experience" class="section">
      <div class="wrap">
        <header class="section__head" data-reveal>
          <p class="eyebrow">Experience</p>
          <h2>Where I’ve worked.</h2>
        </header>
        <ol class="jobs">
          {experience.map((job) => (
            <li class="job card" data-reveal>
              <div class="job__head">
                <h3>{job.company}</h3>
                <span class="pill">{job.place}</span>
              </div>
              {job.roles.map((r) => (
                <div class="role">
                  <p class="role__period mono">{r.period}</p>
                  <div>
                    <h4>{r.title}</h4>
                    <ul class="ticks">
                      {r.points.map((p) => <li>{p}</li>)}
                    </ul>
                  </div>
                </div>
              ))}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── Skills ───────────────────────────────────────── -->
    <section id="skills" class="section section--alt">
      <div class="wrap">
        <header class="section__head" data-reveal>
          <p class="eyebrow">Skills</p>
          <h2>The stack behind <span class="grad">the systems.</span></h2>
          <p class="section__sub muted">Languages, frameworks and databases I use in production, plus the data and delivery practices around them.</p>
        </header>
        <SkillsShowcase />
      </div>
    </section>

    <!-- ── Contact ──────────────────────────────────────── -->
    <section id="contact" class="section contact">
      <div class="contact__glow" aria-hidden="true"></div>
      <div class="wrap contact__inner">
        <div class="contact__copy" data-reveal>
          <p class="eyebrow">Contact</p>
          <h2>Let’s build something <span class="grad">reliable.</span></h2>
          <p class="muted">Open to backend and full-stack roles, freelance projects and conversations about fintech systems.</p>
          <div class="email">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <button class="btn btn--ghost btn--sm" type="button" data-copy={profile.email}>
              <span data-copy-status aria-live="polite">Copy</span>
            </button>
          </div>
          <ul class="socials">
            <li><a class="btn btn--ghost btn--sm" href={profile.linkedin} target="_blank" rel="me noopener">LinkedIn ↗</a></li>
            <li><a class="btn btn--ghost btn--sm" href={profile.github} target="_blank" rel="me noopener">GitHub ↗</a></li>
            <li><a class="btn btn--ghost btn--sm" href={profile.cv} download>Résumé ↓</a></li>
          </ul>
        </div>

        <form class="form card card--accent" action="/api/contact" method="post" data-contact data-reveal novalidate>
          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" autocomplete="name" required minlength="2" maxlength="100" />
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="254" />
          </div>
          <div class="field">
            <label for="f-message">Message</label>
            <textarea id="f-message" name="message" rows="5" required minlength="10" maxlength="5000"></textarea>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="f-company">Company</label>
            <input id="f-company" name="company" tabindex="-1" autocomplete="off" />
          </div>
          <button class="btn btn--primary btn--block" type="submit">
            <span data-submit-label>Send message</span>
          </button>
          <p class="form__status" role="status" aria-live="polite" data-form-status></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <p>© {year} {profile.name} · Kathmandu, Nepal</p>
      <p>Press <kbd>⌘</kbd><kbd>K</kbd> to navigate · <a class="link" href="#top">Back to top ↑</a></p>
    </div>
  </footer>

  <!-- ── Command palette ───────────────────────────────── -->
  <dialog class="cmdk" data-cmdk aria-label="Command menu">
    <div class="cmdk__box">
      <input class="cmdk__input" type="text" placeholder="Type a command or search…" aria-label="Search commands" data-cmdk-input autocomplete="off" />
      <ul class="cmdk__list" role="listbox" data-cmdk-list>
        {commands.map((c) => (
          <li role="option" aria-selected="false">
            <a
              href={c.href ?? '#'}
              data-action={c.action}
              download={c.download ? '' : undefined}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener' : undefined}
            >
              <span>{c.label}</span><span class="cmdk__hint">{c.hint}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="cmdk__foot mono">↑↓ navigate · ↵ select · esc close</p>
    </div>
  </dialog>

  <script>
    import '../scripts/main.ts';
  </script>
</Base>
