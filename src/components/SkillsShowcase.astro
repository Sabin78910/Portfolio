---
// Skills as 3D-tilt cards: real brand logos (simple-icons, CC0) for tools, described capability rows for practices.
// Rendered at build time — ships as static SVG, no client JS.
import * as si from 'simple-icons';
import { skills } from '../data/profile';

type Brand = { path: string; hex: string };
const brands: Record<string, Brand> = {
  Python: si.siPython,
  PHP: si.siPhp,
  JavaScript: si.siJavascript,
  R: si.siR,
  HTML: si.siHtml5,
  CSS: si.siCss,
  Java: si.siOpenjdk,
  Flask: si.siFlask,
  FastAPI: si.siFastapi,
  Pydantic: si.siPydantic,
  pytest: si.siPytest,
  Docker: si.siDocker,
  'GitHub Actions': si.siGithubactions,
  Linux: si.siLinux,
  'Laravel 11': si.siLaravel,
  'Bootstrap 5': si.siBootstrap,
  PostgreSQL: si.siPostgresql,
  MySQL: si.siMysql,
  Git: si.siGit,
  GitHub: si.siGithub,
  'PayPal API': si.siPaypal,
  React: si.siReact,
  'Next.js': si.siNextdotjs,
  'Android development': si.siAndroid,
};

// 24×24 stroke icons: tools without an official logo, and capability rows.
const db = '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>';
const glyphs: Record<string, string> = {
  SQL: db,
  'Oracle Database': db,
  'REST APIs': '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5a2 2 0 0 1 2-2 2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/>',
  'Oracle APEX': '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
  PHPMailer: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  'VS Code': '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  'Game development': '<path d="M6 12h4"/><path d="M8 10v4"/><path d="M15 13h.01"/><path d="M18 11h.01"/><rect width="20" height="12" x="2" y="6" rx="2"/>',
  // simple-icons no longer ships the AWS mark (trademark), so AWS gets a cloud glyph.
  AWS: '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
  // capabilities
  clean: '<path d="M3 6h18"/><path d="M6 12h12"/><path d="M10 18h4"/>',
  layers: '<path d="m12 2 9 5-9 5-9-5 9-5z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
  chart: '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>',
  sprint: '<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  pipeline: '<circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="12" r="2.5"/><path d="M7.5 12h9"/><path d="m13 8 3.5 4-3.5 4"/>',
  plug: '<path d="M9 2v6"/><path d="M15 2v6"/><path d="M6 8h12v3a6 6 0 0 1-12 0V8z"/><path d="M12 17v5"/>',
};

// Dark brand colours (GitHub, OpenJDK, PayPal) would vanish on navy — fall back to the text colour.
const lum = (hex: string) => {
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const tone = (hex: string) => (lum(hex) < 0.32 ? '#e8ecf4' : `#${hex}`);

// Bento layout by group: four halves, then Cloud/DevOps and Data & ML as full-width strips.
const sizes: Record<string, string> = { 'Cloud, DevOps & testing': 'full', 'Data & ML': 'wide' };
type Group = (typeof skills)[number] & {
  tools?: string[];
  capabilities?: { icon: string; title: string }[];
  evidence?: { label: string; href: string };
};
const groups = (skills as Group[]).map((g) => ({ ...g, size: sizes[g.group] ?? 'half' }));
const count = (g: Group) => (g.tools?.length ?? 0) + (g.capabilities?.length ?? 0);
---

<div class="stack">
  {groups.map((g) => (
    <article class={`stack__cell stack__cell--${g.size}`} data-reveal>
      <div class="stack__card" data-tilt>
        <span class="stack__sheen" aria-hidden="true"></span>
        <header class="stack__head">
          <h3>{g.group}</h3>
          <span class="stack__count mono">{String(count(g)).padStart(2, '0')}</span>
        </header>
        <div class="stack__layer">
          {g.tools && (
            <ul class="stack__tools">
              {g.tools.map((t) => (
                <li class="tool" style={brands[t] ? `--brand:${tone(brands[t].hex)}` : '--brand:#a5b4fc'}>
                  {brands[t] ? (
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={brands[t].path} fill="currentColor" /></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[t]} />
                  )}
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          )}
          {g.capabilities && (
            <ul class="caps">
              {g.capabilities.map((c) => (
                <li class="cap">
                  <span class="cap__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[c.icon]} />
                  </span>
                  <strong class="cap__title">{c.title}</strong>
                </li>
              ))}
            </ul>
          )}
          {g.evidence && (
            <a class="link stack__evidence" href={g.evidence.href}>{g.evidence.label} <span aria-hidden="true">→</span></a>
          )}
        </div>
      </div>
    </article>
  ))}
</div>
